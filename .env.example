# Copy to .env for local runs. In production these live in GitHub Actions
# secrets (agents) and Vercel environment variables (dashboard), never in git.

# --- Agents (GitHub Actions) ---
ANTHROPIC_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: agents only. Never expose it to the dashboard or browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults shown)
# HACKAGENT_MODEL_CHEAP=claude-haiku-5-5
# HACKAGENT_MODEL_MID=claude-sonnet-5-5
# HACKAGENT_MODEL_TOP=claude-opus-5-5
# HACKAGENT_DRY_RUN=false
# HACKAGENT_WORKSPACE_DIR=workspace
