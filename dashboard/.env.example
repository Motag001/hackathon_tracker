# Vercel environment variables for the dashboard.
# Never put the service role key or the Anthropic key in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is no sign-in. The server acts as the owner by minting a short-lived
# token for this user, signed with the project's JWT secret. Server-only (no
# NEXT_PUBLIC_ prefix); mark both Sensitive in Vercel.
OWNER_USER_ID=
SUPABASE_JWT_SECRET=
