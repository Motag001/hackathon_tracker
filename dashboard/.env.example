# Vercel environment variables for the dashboard.
# Never put the service role key or the Anthropic key in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is no sign-in page: the server signs in to Supabase as the owner with
# these. Server-only (no NEXT_PUBLIC_ prefix); mark them Sensitive in Vercel.
OWNER_EMAIL=
OWNER_PASSWORD=
